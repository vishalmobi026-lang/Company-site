# --- DATABASE CONFIGURATION ---
# Format: postgresql://username:password@localhost:port/database_name
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/gtecdb

# --- SECURITY CONFIGURATION ---
# Secret key for JWT token generation. Generate a strong one!
SECRET_KEY=4eb8d58c899c72e259e863690d54030678e760c6d525712e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- SMTP EMAIL CONFIGURATION (For Contact Form Notifications) ---
# The email address that will receive the inquiries
EMAIL_TARGET=your-office-email@gmail.com

# SMTP Server Details (Example for Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# The email account used to send the emails (Must support App Passwords)
SMTP_USER=your-email@gmail.com

# Your Google App Password (NOT your regular password)
# Get it from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password-here
